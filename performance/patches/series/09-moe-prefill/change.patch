diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 41d1801..573a9e7 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1,3 +1,4 @@
+#include <atomic> // KCPP_MOE_PREFILL_COPY_ALL diagnostic guard
 #include "llama-context.h"
 
 #include "ggml.h"
@@ -3014,10 +3015,26 @@ bool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor
         return false;
     }
 
-    // the scheduler calls this before the previous splits are done, and dst may still be in use
-    ggml_backend_synchronize(backend);
-
     const ggml_tensor * ids = node->src[2];
+    // KCPP_MOE_PREFILL_COPY_ALL: copy immutable host experts without a routing readback.
+    // Unlike the old scheduler patch, modern expert copies live in this context callback.
+    // Copying extra experts changes traffic only; selected experts and arithmetic are unchanged.
+    static const bool copy_all_prefill = []() {
+        const char * option = getenv("KCPP_MOE_PREFILL_COPY_ALL");
+        return option != nullptr && atoi(option) != 0;
+    }();
+    if (copy_all_prefill && !lctx->moe_cache && src->ne[2] > 0 &&
+        ggml_nelements(ids) >= 8 * src->ne[2]) {
+        static std::atomic<bool> announced{false};
+        if (!announced.exchange(true)) {
+            LLAMA_LOG_INFO("KCPP_MOE_PREFILL_COPY_ALL: routing readback bypass active\n");
+        }
+        ggml_backend_tensor_set_async(backend, dst, src->data, 0, ggml_nbytes(src));
+        return true;
+    }
+
+    // Other callbacks still require the original synchronization before overwriting dst.
+    ggml_backend_synchronize(backend);
     if (ggml_nelements(ids) == 0) {
         return true;
     }
