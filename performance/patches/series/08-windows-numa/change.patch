+static BOOL CALLBACK kcpp_win_numa_init(PINIT_ONCE once, PVOID parameter, PVOID * context) {
+    UNUSED(once); UNUSED(parameter); UNUSED(context);
+    const char * option = getenv("KCPP_WIN_NUMA_POLICY");
