+        auto * out=(float*)((char*)dst->data+i1*nb1+i2*nb2+i3*nb3);
+        for(int64_t block=0;block<groups;++block){
+            float z[20];
+            for(int64_t i=0;i<factor;++i){float sum=0;for(int64_t j=0;j<factor;++j)sum+=ggml_fwht_load(x[block*factor+j])*(factor==12?H12[j][i]:H20[j][i]);z[i]=sum*scale;}
