+static void kcpp_fwht_kronecker(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * src0=dst->src[0], *src1=dst->src[1];
+    GGML_TENSOR_BINARY_OP_LOCALS
+    int64_t factor=0,groups=0;
+    for(int64_t f:{12,20})if(ne10%f==0){auto q=ne10/f;if(q>0&&(q&(q-1))==0){factor=f;groups=q;break;}}
+    GGML_ASSERT(factor==12||factor==20);
+    const float scale=1.f/sqrtf(float(ne10));
+    const int64_t nr=ne11*ne12*ne13,dr=(nr+params->nth-1)/params->nth;
+    for(int64_t r=params->ith*dr;r<MIN(nr,(params->ith+1)*dr);++r){
+        auto i3=r/(ne11*ne12),i2=(r-i3*ne11*ne12)/ne11,i1=r-i3*ne11*ne12-i2*ne11;
