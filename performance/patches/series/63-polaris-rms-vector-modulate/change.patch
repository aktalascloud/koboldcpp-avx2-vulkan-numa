+float kcpp_rms_modulate(float value, uint col) {
+    // Match the stored weighted result, MUL, ADD, ADD stages; never fold to (1+scale)*x.
+    modulation_input[gl_LocalInvocationIndex] = value;
+    memoryBarrierShared();
+    float weighted = modulation_input[gl_LocalInvocationIndex];
+    precise float product = weighted * data_c[col];
+    precise float result = weighted + product;
+    result += data_e[col];
+    return result;
