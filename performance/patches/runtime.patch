+        (d->properties.deviceID != 0x67df && d->properties.deviceID != 0x6fdf) ||
+        i + 5 > graph->n_nodes || !ggml_can_fuse_subgraph(graph, i, rms_norm_modulate_pattern, {i + 4})) {
+        return false;
