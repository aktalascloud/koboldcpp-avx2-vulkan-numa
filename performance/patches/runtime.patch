+    for (const ggml_tensor * t : {weighted->src[1], scaled->src[1], dst->src[1]}) {
+        if (!t || t->type != GGML_TYPE_F32 || t->ne[0] != rms->ne[0] || !ggml_is_vector(t) ||
+            !ggml_is_contiguous(t) || get_misalign_bytes(ctx, t) != 0 ||
