+    std::vector<std::thread> workers;
+    std::mutex mtx;
+    std::condition_variable cv;
+    std::atomic<uint64_t> gen{0};
+    std::atomic<bool> stop{false};
+    moe_cpu_job * job = nullptr;
+};
