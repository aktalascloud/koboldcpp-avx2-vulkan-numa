-        GGML_UNUSED(first);
-        GGML_UNUSED(last);
+        // Windows cannot unmap part of a view. Release only complete pages of
+        // weights already copied elsewhere; mapped CPU tensors remain readable.
+        last = std::min(last, size);
+        if (first >= last) {
+            return;
+        }
